#!/bin/bash
# Write the Stella sink to stdout as raw s16le, 48 kHz, stereo.
# TigerVNC does not forward audio. `play --target aws` pipes this into a
# local player (sox play, ffmpeg audiotoolbox, or ffplay) over SSH.
#
# Prefer pw-cat --target stella. Recording stella.monitor via parec often
# returns silence while Stella is playing into the stella sink.
set -euo pipefail

uid=$(id -u)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${uid}}"
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "${XDG_RUNTIME_DIR}/bus" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

if [[ -x /usr/local/bin/stella-audio-setup ]]; then
  /usr/local/bin/stella-audio-setup
fi

if command -v pw-cat >/dev/null 2>&1; then
  exec pw-cat --record \
    --target stella \
    --format s16 \
    --rate 48000 \
    --channels 2 \
    -
fi

if command -v parec >/dev/null 2>&1; then
  exec parec \
    --device=stella.monitor \
    --format=s16le \
    --rate=48000 \
    --channels=2 \
    --latency-msec=50
fi

echo "stella-audio-capture: need pw-cat (pipewire-utils) or parec (pulseaudio-utils)" >&2
exit 1
